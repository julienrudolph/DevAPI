WEB_BIND_ADDRESS=127.0.0.1
WEB_HOST_PORT=8080
API_HOST_PORT=3001
PROXY_HOST_PORT=3002
POSTGRES_HOST_PORT=54322
SUPABASE_HOST_PORT=8000
MAIL_HOST_PORT=9000

SITE_URL=http://localhost:8080
SUPABASE_PUBLIC_URL=http://localhost:8000
SUPABASE_INTERNAL_URL=http://supabase-gateway:8000

# Mit `npm run compose:env` sicher generieren, nicht unverändert verwenden.
POSTGRES_PASSWORD=replace-me
JWT_SECRET=replace-me-with-at-least-32-characters
SUPABASE_PUBLISHABLE_KEY=replace-me
# Optional: nur nötig, damit Nutzer ihr eigenes Konto selbst löschen können
# (AGENTS.md 7.4). Ohne diesen Wert meldet die API die Funktion als nicht
# verfügbar, statt fehlzuschlagen. Niemals an den Browser ausliefern.
SUPABASE_SERVICE_ROLE_KEY=
PROXY_INTERNAL_TOKEN=replace-me
METRICS_TOKEN=replace-me-with-at-least-32-characters
EXECUTION_RATE_WINDOW_MS=60000
EXECUTION_RATE_PER_USER=60
EXECUTION_RATE_PER_WORKSPACE=300
EXECUTION_CONCURRENCY_PER_USER=3
EXECUTION_CONCURRENCY_PER_WORKSPACE=10
PROXY_MAX_CONCURRENT_REQUESTS=50

# Optional: vorgeschalteter Unternehmens-Proxy für ausgehende Requests des
# apps/proxy-Containers (Ziel-APIs). Wird ein Wert gesetzt, entfällt für den
# betroffenen Zielhost das IP-Pinning gegen DNS-Rebinding (AGENTS.md 11.1) -
# der vorgeschaltete Proxy übernimmt dann selbst die Namensauflösung.
# NO_PROXY nimmt kommagetrennte Hostnamen/Domains oder "*" (Proxy komplett
# deaktivieren) entgegen; ein führender Punkt oder eine nackte Domain deckt
# auch Subdomains ab (z. B. "corp.example" matcht "ci.corp.example").
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# Optional, bei Supabase Auth als Custom Provider konfigurieren.
OIDC_PROVIDER=
OIDC_LABEL=Mit Firmenkonto anmelden

# Einfachster Testbetrieb: Passwort-Anmeldung und Registrierung ohne E-Mail.
PASSWORD_AUTH_ENABLED=true
PASSWORD_SIGNUP_ENABLED=true
MAGIC_LINK_AUTH_ENABLED=false
AUTH_DISABLE_SIGNUP=false
AUTH_AUTOCONFIRM=true
