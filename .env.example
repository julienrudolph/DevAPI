# Öffentliche Supabase-Projektwerte. Der Service-Role-Schlüssel gehört nie hierher.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional: In Supabase Auth konfigurierter Custom-OIDC-Provider.
VITE_OIDC_PROVIDER=custom:company-oidc
VITE_OIDC_LABEL=Mit Firmenkonto anmelden

# Serverseitige API-Konfiguration. Auch hier keinen Service-Role-Schlüssel nutzen:
# Der Benutzer-JWT wird an Supabase weitergereicht, damit RLS greift.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
API_PORT=3001

# Ausschließlich serverseitig für API → Proxy.
PROXY_INTERNAL_TOKEN=replace-with-a-long-random-value
