# Optionale Werte für direkt gestartete lokale Prozesse.
# Für den normalen Einstieg `npm run compose:env` und `npm run compose:up`
# verwenden. Der Service-Role-Schlüssel gehört niemals hierher.
VITE_SUPABASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-generated-local-publishable-key

# Erst nach serverseitiger Provisionierung eines Custom-OIDC-Providers setzen.
VITE_OIDC_PROVIDER=
VITE_OIDC_LABEL=Mit Firmenkonto anmelden
VITE_PASSWORD_AUTH_ENABLED=true
VITE_PASSWORD_SIGNUP_ENABLED=true
VITE_MAGIC_LINK_AUTH_ENABLED=false

# Serverseitige API-Konfiguration. Auch hier keinen Service-Role-Schlüssel nutzen:
# Der Benutzer-JWT wird an Supabase weitergereicht, damit RLS greift.
SUPABASE_URL=http://127.0.0.1:8000
PUBLIC_SUPABASE_URL=http://127.0.0.1:8000
SUPABASE_PUBLISHABLE_KEY=replace-with-generated-local-publishable-key
API_PORT=3001

# Ausschließlich serverseitig für API → Proxy.
PROXY_INTERNAL_URL=http://127.0.0.1:3002
PROXY_INTERNAL_TOKEN=replace-with-a-long-random-value
PASSWORD_AUTH_ENABLED=true
PASSWORD_SIGNUP_ENABLED=true
MAGIC_LINK_AUTH_ENABLED=false
