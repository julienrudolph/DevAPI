# Öffentliche Werte
PUBLIC_HOST=devapi.example.de
ACME_EMAIL=admin@example.de
SITE_URL=https://devapi.example.de

# Externes Docker-Netz eines vorhandenen Nginx Proxy Managers.
NPM_NETWORK=botnet
SUPABASE_PUBLIC_URL=https://project.supabase.co

# Interne Serverkonfiguration. Bei Hosted Supabase sind beide URLs identisch.
SUPABASE_INTERNAL_URL=https://project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Mindestens 32 zufällige Zeichen; niemals in Git einchecken.
PROXY_INTERNAL_TOKEN=replace-with-a-long-random-production-value

# Optionaler, serverseitig in Supabase konfigurierter Custom-OIDC-Provider.
OIDC_PROVIDER=
OIDC_LABEL=Mit Firmenkonto anmelden

# Standard für einen einfachen internen Testserver ohne SMTP.
PASSWORD_AUTH_ENABLED=true
PASSWORD_SIGNUP_ENABLED=true
MAGIC_LINK_AUTH_ENABLED=false
